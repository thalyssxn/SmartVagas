# Copie para .env e ajuste. Nunca versione o .env.

# Postgres do `docker compose up -d`.
DATABASE_URL="postgresql://smartvagas:smartvagas@localhost:5432/smartvagas"

# Sem Docker: `npx prisma dev --name smart-vagas --detach` e use as duas linhas abaixo no lugar.
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Better Auth. Gere um segredo com: npx @better-auth/cli secret
BETTER_AUTH_SECRET="troque-este-segredo-por-um-aleatorio-de-32-caracteres"
BETTER_AUTH_URL="http://localhost:3000"

APP_TIMEZONE="America/Sao_Paulo"

# Usuários de teste criados por `npm run db:seed` (somente desenvolvimento).
# E-mails: dono@smartvagas.test, operador@smartvagas.test e motorista@smartvagas.test
SEED_SENHA_DONO="dono-demo-2026"
SEED_SENHA_OPERADOR="operador-demo-2026"
SEED_SENHA_MOTORISTA="motorista-demo-2026"
